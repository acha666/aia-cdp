# Allowlist: only what the Node image build reads. Everything else (node_modules, dist, .git,
# .wrangler, .dev.vars, token files, tests and their fixtures, docs) never reaches the builder.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.base.json
!tsconfig.node.json
!tsconfig.build.json
!vite.config.ts
!src
