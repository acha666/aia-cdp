# Dependencies; pnpm creates .pnpm-store/ when the checkout is a mount of its own (devcontainer)
node_modules/
.pnpm-store/

# Build output
dist/

# Wrangler state and local data (dev:node writes to .data/)
.wrangler/
.data/

# Generated by `pnpm run types` (wrangler types); regenerated before typecheck and lint
worker-configuration.d.ts

# Staging directories of an interrupted tests/fixtures/generate-test-data.sh run (the fixtures
# themselves, tests/fixtures/pki/, are committed)
/tests/fixtures/pki.tmp.*/

# Environment and secrets
.env*.local
.dev.vars*
!.dev.vars.example

# Logs
*.log

# IDE
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
