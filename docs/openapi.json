{
  "openapi": "3.1.0",
  "info": {
    "title": "aia-cdp API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "AIA_ADMIN_TOKEN"
      }
    },
    "schemas": {
      "HealthOk": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "store": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              },
              "configuration": {
                "type": "string",
                "enum": [
                  "ok",
                  "missing",
                  "invalid"
                ]
              }
            },
            "required": [
              "store",
              "configuration"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "HealthUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unhealthy"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "store": {
                "type": "string",
                "enum": [
                  "error"
                ]
              },
              "configuration": {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            },
            "required": [
              "store",
              "configuration"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ImportedCertificate": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "unchanged"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "importedAt": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "$ref": "#/components/schemas/CertificateSummary"
          }
        },
        "required": [
          "outcome",
          "id",
          "size",
          "importedAt",
          "summary"
        ]
      },
      "CertificateSummary": {
        "type": "object",
        "properties": {
          "subjectCN": {
            "type": [
              "string",
              "null"
            ]
          },
          "issuerCN": {
            "type": [
              "string",
              "null"
            ]
          },
          "serialNumber": {
            "type": "string",
            "pattern": "^(?:[0-9A-F]{2})+$"
          },
          "notBefore": {
            "type": "string",
            "format": "date-time"
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          },
          "subjectKeyId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "authorityKeyId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "subjectCN",
          "issuerCN",
          "serialNumber",
          "notBefore",
          "notAfter",
          "subjectKeyId",
          "authorityKeyId",
          "sha1"
        ],
        "additionalProperties": false
      },
      "BadRequestError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UnauthorizedError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ConcurrentUpdateError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "concurrent_update"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "PayloadTooLargeError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "payload_too_large"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UnsupportedMediaTypeError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unsupported_media_type"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "InvalidCertificateError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_certificate"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "der",
                      "trailing_bytes",
                      "time",
                      "structure",
                      "extension_value",
                      "pem_label",
                      "pem_blocks",
                      "pem_base64"
                    ]
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AdminDisabledError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "admin_disabled"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CertificateUpload": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "certificate"
        ]
      },
      "Config": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "certificates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "full",
                    "delta"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "issuer",
                "kind",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "paths": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "certificate": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "certificate"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^[0-9a-f-]+$"
                    }
                  },
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "version",
          "certificates",
          "targets",
          "paths"
        ],
        "additionalProperties": false
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "not_found"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "PreconditionFailedError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "precondition_failed"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ConfigInvalidError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "config_invalid"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "properties": {
                  "issues": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ConfigIssue"
                    }
                  }
                },
                "required": [
                  "issues"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ConfigIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "rule": {
            "type": "string",
            "enum": [
              "V1",
              "V2",
              "V3",
              "V4",
              "V5",
              "V6",
              "V7",
              "V8",
              "V9"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ]
      },
      "PreconditionRequiredError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "precondition_required"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health",
        "description": "Reads the object store and config.json. `degraded` (still 200) while the service is not configured yet or its configuration is invalid; 503 when the store cannot be read.",
        "responses": {
          "200": {
            "description": "The store answers: healthy, or degraded (configuration missing or invalid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "503": {
            "description": "The store failed; the configuration could not be checked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/certificates": {
      "post": {
        "operationId": "importCertificate",
        "summary": "Import a CA certificate",
        "description": "DER or a single PEM block, as the raw body or as the file field `certificate` of a multipart form; the format is recognized from the bytes. Importing does not authorize anything: a certificate only issues CRLs once a config target names it. A PEM bundle is rejected (`pem_blocks`): the CLI sends each block on its own.",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/pkix-cert": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/x-pem-file": {
              "schema": {
                "type": "string"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CertificateUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already imported: the stored entry, nothing was written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportedCertificate"
                }
              }
            }
          },
          "201": {
            "description": "Imported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportedCertificate"
                }
              }
            }
          },
          "400": {
            "description": "Malformed Authorization header, or an invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong admin token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "409": {
            "description": "The catalog kept changing concurrently; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConcurrentUpdateError"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than AIA_MAX_UPLOAD_BYTES",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadTooLargeError"
                }
              }
            }
          },
          "415": {
            "description": "The Content-Type is not one of the request body's media types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeError"
                }
              }
            }
          },
          "422": {
            "description": "Not a certificate this service accepts; `details.reason` says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCertificateError"
                }
              }
            }
          },
          "503": {
            "description": "No admin token is configured (AIA_ADMIN_TOKEN): the admin API is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDisabledError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "Read config.json",
        "description": "The stored bytes as they are, also when an out-of-band write left them invalid (so that they can be repaired). The ETag is the SHA-256 of those bytes, for `If-Match` on PUT.",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The stored config.json",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "description": "The SHA-256 (lowercase hex) of the stored bytes, quoted: \"<sha256>\""
                },
                "required": true,
                "description": "The SHA-256 (lowercase hex) of the stored bytes, quoted: \"<sha256>\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Malformed Authorization header, or an invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong admin token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "404": {
            "description": "Nothing has been configured yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "503": {
            "description": "No admin token is configured (AIA_ADMIN_TOKEN): the admin API is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDisabledError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "applyConfig",
        "summary": "Replace config.json",
        "description": "The whole configuration, checked against rules V1–V9 (every violation in `details.issues`). Exactly one precondition: `If-Match: \"<ETag>\"` from GET, or `If-None-Match: *` for the first configuration.",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The ETag from GET, as sent: \"<sha256>\""
            },
            "required": false,
            "description": "The ETag from GET, as sent: \"<sha256>\"",
            "name": "If-Match",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "`*`: only while nothing is configured"
            },
            "required": false,
            "description": "`*`: only while nothing is configured",
            "name": "If-None-Match",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied: the stored bytes and their new ETag",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "description": "The SHA-256 (lowercase hex) of the stored bytes, quoted: \"<sha256>\""
                },
                "required": true,
                "description": "The SHA-256 (lowercase hex) of the stored bytes, quoted: \"<sha256>\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Malformed Authorization header, or an invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong admin token",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "412": {
            "description": "The precondition does not hold (another apply came first, or W/ / list / *)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreconditionFailedError"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than AIA_MAX_UPLOAD_BYTES",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadTooLargeError"
                }
              }
            }
          },
          "415": {
            "description": "The Content-Type is not one of the request body's media types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeError"
                }
              }
            }
          },
          "422": {
            "description": "The configuration breaks rules V1–V9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigInvalidError"
                }
              }
            }
          },
          "428": {
            "description": "Not exactly one of If-Match and If-None-Match: *",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreconditionRequiredError"
                }
              }
            }
          },
          "503": {
            "description": "No admin token is configured (AIA_ADMIN_TOKEN): the admin API is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDisabledError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
