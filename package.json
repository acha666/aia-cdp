{
  "name": "aia-cdp",
  "description": "X.509 CA certificate and CRL distribution (AIA/CDP) for Cloudflare Workers + R2 and Node 24 + disk",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "types": "WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true wrangler types --env-file=/dev/null",
    "typecheck": "pnpm run types && pnpm run typecheck:worker && pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "vue-tsc -p tsconfig.web.json",
    "lint": "pnpm run types && eslint --max-warnings 0 .",
    "lint:fix": "pnpm run types && eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "node scripts/generate-openapi.ts",
    "check": "pnpm run typecheck && eslint --max-warnings 0 . && pnpm run format:check",
    "test": "vitest run",
    "test:r2": "WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true AIA_TEST_R2=1 vitest run tests/storage/r2.test.ts",
    "fixtures": "bash tests/fixtures/generate-test-data.sh",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server/runtime/node.js",
    "dev:web": "vite",
    "dev:node": "mkdir -p .data && PORT=8787 AIA_DATA_DIR=.data node src/runtime/node.ts",
    "dev:worker": "pnpm run build:web && WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true wrangler dev --ip 127.0.0.1 --port 8787",
    "aia": "node src/cli/aia.ts",
    "seed:dev": "node scripts/seed-dev.ts",
    "reset:dev": "rm -rf .wrangler/state .data",
    "smoke:worker": "node scripts/worker-smoke.ts",
    "verify": "pnpm run check && pnpm run test && pnpm run build",
    "ci:check": "pnpm run check",
    "ci:test": "pnpm run test && pnpm run build",
    "ci:worker": "pnpm run build:web && WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true wrangler deploy --dry-run --outdir dist/worker && pnpm run smoke:worker && pnpm run test:r2",
    "ci:docker": "bash scripts/docker-smoke.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "asn1js": "3.1.0",
    "hono": "4.13.13",
    "pkijs": "3.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/vue": "1.59.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query": "5.104.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.3",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "reka-ui": "2.11.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.1"
  }
}
