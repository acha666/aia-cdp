{
  // Shared options only; never compiled directly. Each leaf config sets lib, types and include.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    // No implicit @types/* inclusion anywhere: each leaf lists exactly the ambient types it may see.
    "types": [],
    // Relative imports carry a .ts extension: Node 24 runs the sources directly (type stripping)
    // and tsc -p tsconfig.build.json rewrites them to .js. Only erasable syntax (no enum,
    // namespace or constructor parameter properties) and explicit `import type`.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // pkijs and wrangler declaration files do not type-check cleanly on their own.
    "skipLibCheck": true
    // exactOptionalPropertyTypes stays off: the generated shadcn-vue components fail it.
  }
}
