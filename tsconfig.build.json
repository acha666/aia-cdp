{
  // Emit-only: compiles the import graphs of src/runtime/node.ts and src/cli/aia.ts to dist/server
  // for `pnpm start` and the Docker image. Not referenced from tsconfig.json.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/server",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/runtime/node.ts", "src/cli/aia.ts"]
}
