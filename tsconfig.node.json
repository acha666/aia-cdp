{
  // Node program (type check only): the Node graph of src (with the CLI), scripts, node-side tests
  // and the tool configs. Only @types/node is visible, so R2Bucket / Env / ExportedHandler fail here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "scripts", "tests", "*.config.ts"],
  "exclude": ["src/web", "src/runtime/worker.ts", "tests/web"]
}
