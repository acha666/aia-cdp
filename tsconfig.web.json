{
  // Browser program checked by vue-tsc: src/web (plus the server types it reaches through
  // `import type { AppType }`) and the happy-dom component tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // ESNext.TypedArrays only for the core files AppType reaches: src/web never calls those
    // methods, which browsers before Chrome 140 lack.
    "lib": ["ES2024", "ESNext.TypedArrays", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // Generated shadcn-vue code imports without extensions.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/web/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.vue", "tests/web/**/*.ts"]
}
