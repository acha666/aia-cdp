{
  // Cloudflare Workers program. Globals come only from `wrangler types`
  // (.wrangler/types/worker-configuration.d.ts, generated by `pnpm run types`): no DOM lib and no
  // @types/node, so process / Buffer / node:* reachable from these files fail here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["./.wrangler/types/worker-configuration.d.ts"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "src/core/**/*.ts",
    "src/http/**/*.ts",
    "src/storage/r2.ts",
    "src/runtime/worker.ts",
    "src/runtime/settings.ts"
  ]
}
