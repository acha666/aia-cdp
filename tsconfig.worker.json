{
  // Cloudflare Workers program. Globals come only from `wrangler types` (worker-configuration.d.ts,
  // generated by `pnpm run types`): no DOM lib and no @types/node, so process / Buffer / node:*
  // reachable from these files fail here. Listing `types` explicitly matters: with only an include,
  // TypeScript auto-includes node_modules/@types/node and the boundary silently disappears.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/http/**/*.ts",
    "src/storage/r2.ts",
    "src/runtime/worker.ts",
    "src/runtime/settings.ts",
    "tests/boundary/worker-canary.ts"
  ]
}
